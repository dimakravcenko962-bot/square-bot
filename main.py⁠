import os
import asyncio
from aiogram import Bot, Dispatcher, types, F
from aiogram.filters import Command

TOKEN = os.getenv("BOT_TOKEN")
bot = Bot(token=TOKEN)
dp = Dispatcher()

@dp.message(Command("start"))
async def cmd_start(message: types.Message):
    await message.answer("Привіт! Я ваш новий бот для Binance Square. Готовий до роботи! 🚀\n\nНапишіть мені «зроби пост» або «аналіз ринку».")

@dp.message(F.text.lower().contains("пост"))
async def create_post(message: types.Message):
    await message.answer("📝 Готую ідею та текст для Binance Square...\n\n(Тут скоро буде автоматична генерація крипто-контенту)")

@dp.message(F.text.lower().contains("аналіз"))
async def market_analysis(message: types.Message):
    await message.answer("📊 Отримую дані ринку та аналізую ситуацію...\n\n(Тут скоро з'явиться аналітика та тренди)")

async def main():
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
